# Required — OpenRouter API key
OPENROUTER_API_KEY=

# Optional — override the default chat/tool model (default: deepseek/deepseek-v3.2)
# Examples: anthropic/claude-haiku-4.5, anthropic/claude-sonnet-4.5, openai/gpt-5-mini
OPENROUTER_MODEL_ID=

# Required — your email for OpenAlex polite pool
OPENALEX_MAILTO=

# Optional — OpenAlex API key for higher rate limits
OPENALEX_API_KEY=
