# ---- Required ----

# OpenRouter API key. Every LLM call in the pipeline routes through OpenRouter.
OPENROUTER_API_KEY=

# Your email, sent with every OpenAlex request to join the polite pool.
# https://docs.openalex.org/how-to-use-the-api/rate-limits-and-authentication
OPENALEX_MAILTO=

# ---- Optional ----

# OpenAlex API key for higher rate limits.
OPENALEX_API_KEY=

# Fallback model for every stage that doesn't set its own.
# Default: deepseek/deepseek-v3.2
OPENROUTER_DEFAULT_MODEL_ID=

# Per-stage model overrides. Each falls back to OPENROUTER_DEFAULT_MODEL_ID.
# See src/lib/ai/openrouter.ts.
OPENROUTER_ONBOARDING_MODEL_ID=
OPENROUTER_PROPOSAL_MODEL_ID=
OPENROUTER_SEEDS_MODEL_ID=
OPENROUTER_LIBRARY_MODEL_ID=
OPENROUTER_FILTER_MODEL_ID=

# The curator is the one stage that defaults to a premium model.
# Default: openai/gpt-5.4
OPENROUTER_CURATOR_MODEL_ID=
